{
  "manifest_version": 3,
  "name": "GitHub → Orca",
  "version": "0.1.0",
  "description": "Open a GitHub pull request in an Orca workspace, with an agent.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "key": ""
}
